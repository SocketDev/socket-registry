{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "types": ["node"]
  },
  "include": ["registry/src/**/*.mts", "registry/scripts/**/*.mts", "scripts/**/*.mts"],
  "exclude": ["**/node_modules/**", "scripts/templates/**"]
}
